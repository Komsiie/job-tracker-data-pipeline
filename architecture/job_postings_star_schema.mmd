erDiagram
    DIM_COMPANIES ||--o{ FACT_JOB_POSTINGS_SNAPSHOT : "company_sk"
    DIM_LOCATIONS ||--o{ FACT_JOB_POSTINGS_SNAPSHOT : "location_sk"
    FACT_JOB_POSTINGS_SNAPSHOT ||--o{ BRIDGE_JOB_SKILLS : "posting_key"
    DIM_SKILLS ||--o{ BRIDGE_JOB_SKILLS : "skill_sk"

    FACT_JOB_POSTINGS_SNAPSHOT {
        string fact_job_postings_sk PK
        string posting_key "grain key + bridge FK"
        timestamp source_ingest_timestamp "grain / scrape event"
        string company_sk FK
        string location_sk FK
        string job_title
        string employment_type
        boolean remote_flag
        date job_posted_at
        string job_apply_link
        string job_publisher
        number min_salary
        number max_salary
        date first_seen_date "derived, window fn"
        date last_seen_date "derived, window fn"
        boolean is_active "derived, window fn"
        timestamp snowflake_load_timestamp "audit only"
    }

    DIM_COMPANIES {
        string company_sk PK
        string employer_name
    }

    DIM_LOCATIONS {
        string location_sk PK
        string job_city
        string job_state
        string job_country
    }

    DIM_SKILLS {
        string skill_sk PK
        string skill_name
        string skill_category
    }

    BRIDGE_JOB_SKILLS {
        string posting_key FK "from int_jobs, hash(job_uid, employer_name)"
        string skill_sk FK
    }