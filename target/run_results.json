_jobs\nQUALIFY ROW_NUMBER() OVER (\n    PARTITION BY \n        job_uid, \n        employer_name,\n        source_ingest_timestamp\n    order by job_publisher desc) = 1", "relation_name": "JOB_DB.INTERMEDIATE.int_jobs", "batch_results": null, "overload_results": null}], "elapsed_time": 7.223751544952393, "args": {"macro_debugging": false, "require_corrected_analysis_fqns": false, "quiet": false, "log_format": "default", "version_check": true, "partial_parse_file_diff": true, "log_path": "D:\\Data Engineering\\jobtracker\\logs", "allow_jinja_file_extensions": false, "require_generic_test_arguments_property": true, "use_catalogs_v2": false, "favor_state": false, "state_modified_compare_vars": false, "show_resource_report": false, "use_colors": true, "require_valid_schema_from_generate_schema_name": false, "profiles_dir": "C:\\Users\\komal\\.dbt", "require_ref_searches_node_package_before_root": false, "require_batched_execution_for_custom_microbatch_strategy": true, "source_freshness_run_project_hooks": true, "vars": {}, "support_custom_ref_kwargs": false, "which": "run", "cache_selected_only": false, "defer": false, "state_modified_compare_more_unrendered_values": true, "v2_parser": "dbt-core-experimental-parser parse", "print": true, "invocation_command": "dbt run --select int_jobs", "exclude": [], "populate_cache": true, "maximum_seed_size_mib": 1, "warn_error_options": {"error": [], "warn": [], "silence": []}, "send_anonymous_usage_stats": true, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "printer_width": 80, "introspect": true, "indirect_selection": "eager", "partial_parse": true, "log_format_file": "debug", "require_resource_names_without_spaces": true, "require_explicit_package_overrides_for_builtin_materializations": true, "project_dir": "D:\\Data Engineering\\jobtracker", "skip_nodes_if_on_run_start_fails": true, "log_level_file": "debug", "static_parser": true, "latest_version_pointer_enabled_by_default": false, "require_yaml_config